# Wzor konfiguracji. Skopiuj do .env i uzupelnij — .env jest w .gitignore.
#
#     cp .env.example .env
#
# Ten plik CELOWO nie zawiera zadnych wartosci poufnych. Wypelnione pola
# zostawiaja slad w historii repozytorium i uruchamiaja skanery sekretow,
# nawet gdy wpisana wartosc jest tylko przykladowa.

MSSQL_HOST=localhost,1433
MSSQL_DB=Kartoteka
MSSQL_USER=sa

# Wymagane. Bez tego aplikacja odmowi startu — nie ma wartosci domyslnej w kodzie.
MSSQL_PASSWORD=

# Alternatywnie: jeden gotowy connection string zamiast pol powyzej.
# MSSQL_HOST/DB/USER/PASSWORD sa wtedy pomijane.
# KARTOTEKA_CS=
