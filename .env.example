# Skopiuj do .env i wpisz wlasne haslo. Plik .env jest w .gitignore.
#   cp .env.example .env

MSSQL_HOST=localhost,1433
MSSQL_DB=Kartoteka
MSSQL_USER=sa
MSSQL_PASSWORD=zmien-to-na-wlasne-haslo

# Albo zamiast powyzszych — jeden gotowy connection string:
# KARTOTEKA_CS=Server=localhost,1433;Database=Kartoteka;User Id=sa;Password=...;TrustServerCertificate=True;
